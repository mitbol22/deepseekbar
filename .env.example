DEEPSEEK_API_KEY=sk-your-key-here

# Optional: fixed amount that counts as 100% (default: your balance right after the latest top-up)
# DS_BUDGET=50

# Optional: get a macOS notification when the balance drops below this percentage (default 15)
# DS_ALERT_PERCENT=15

# Optional: how often to check the balance, in minutes (default 15, minimum 1)
# DS_REFRESH_MINUTES=15

# Optional: exchange rate used by the ¥ / $ switch (default 7.1)
# DS_CNY_PER_USD=7.1
